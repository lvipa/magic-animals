{
  "name": "magic-animals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tv": "node server/tv-server.mjs",
    "test:tv": "node scripts/test-tv.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:review": "node scripts/build-milo-review-viewer.mjs",
    "build:review:incoming": "node scripts/build-milo-incoming-review.mjs",
    "test:review:incoming": "node scripts/check-milo-incoming-review.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src scripts server vite.config.ts tsconfig.json package.json",
    "cards": "node scripts/generate-cards.mjs",
    "targets": "node scripts/compile-targets.mjs",
    "models": "node scripts/export-models.mjs",
    "test:models": "node scripts/check-models.mjs",
    "test:tracking": "node scripts/verify-tracking.mjs",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.17.10",
    "howler": "^2.2.4",
    "mind-ar": "1.2.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.160.1",
    "ws": "^8.22.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.55.1",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "mind-ar": {
      "canvas": "^3.2.3"
    }
  }
}
